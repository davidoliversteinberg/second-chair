{
  "name": "second-chair-companion",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "start": "node server/index.mjs",
    "demo": "node server/index.mjs --demo",
    "desktop": "electron .",
    "desktop:demo": "electron . --demo",
    "test": "node --test tests/*.test.mjs",
    "assets": "node scripts/build-icons.mjs",
    "package:mac": "npm run build && npm run assets && electron-builder --mac zip --publish never -c.mac.identity=-",
    "package:mac:signed": "npm run build && npm run assets && electron-builder --mac zip --publish never -c.mac.notarize=true",
    "smoke:mac": "node scripts/smoke-packaged.mjs",
    "format": "prettier --write src server electron tests/companion.test.mjs scripts/build-icons.mjs package.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.293",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@optiaxiom/globals": "3.0.7",
    "@optiaxiom/icons": "1.10.0",
    "@optiaxiom/react": "3.4.0",
    "@phosphor-icons/core": "2.1.1",
    "@phosphor-icons/react": "2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "prettier": "3.9.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.35.5",
    "vite": "6.4.2"
  },
  "description": "A local tray, alert inbox, and chat companion for Second Chair.",
  "author": "David Steinberg",
  "license": "MIT",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.secondchair.companion",
    "productName": "Second Chair",
    "asar": true,
    "asarUnpack": [
      "node_modules/@anthropic-ai/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/client/**",
      "server/**",
      "electron/**",
      "assets/**",
      "package.json",
      "NOTICE.md"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "assets/icon.png"
    },
    "artifactName": "Second-Chair-${version}-${arch}.${ext}"
  },
  "engines": {
    "node": ">=22"
  }
}
